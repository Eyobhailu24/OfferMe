# The local helper supplies DATABASE_URL and a generated development auth secret.
# Set these explicitly in production; never commit live credentials.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/offerme
# BETTER_AUTH_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
PORT=4100
HOST=127.0.0.1
WEB_ORIGIN=http://127.0.0.1:3100
BETTER_AUTH_URL=http://127.0.0.1:4100
# true = print the real sign-in code in the backend terminal (no SMS).
# false = send only through AfroMessage; a token is required. No console fallback.
optbypass=true
AFROMESSAGE_TOKEN=
AFROMESSAGE_SENDER=
# Optional shortcode identifier; leave blank for the provider's default.
AFROMESSAGE_IDENTIFIER_ID=

# Storage for NEW uploads: false = Cloudinary, true = AWS S3.
# Restart the backend after changing switches or credentials.
AWS=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
AWS_REGION=
AWS_S3_BUCKET=
# Use an IAM role/profile in AWS, or uncomment these for local credentials.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Keep credentials/access for old S3 objects when switching to Cloudinary.
# Missing cloud configuration returns 503 on upload; never falls back to disk.
# ADMIN_PHONES=+2519XXXXXXXX
# TRUSTED_PROXY_IPS=127.0.0.1,::1
# Trust only actual proxy addresses. The API must not be publicly reachable through untrusted forwarding hops.
