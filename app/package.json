{
  "name": "offerme-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "check:jsx": "node scripts/check-native-text.mjs",
    "export": "expo export --platform android --platform ios",
    "android:local": "node scripts/android-local.mjs",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "check:fingerprint": "node scripts/check-fingerprint.mjs",
    "check:locales": "node scripts/check-locales.mjs"
  },
  "dependencies": {
    "@better-auth/expo": "1.7.14",
    "@expo/vector-icons": "^15.0.2",
    "@tanstack/react-query": "^5.104.3",
    "@types/react": "~19.3.0",
    "better-auth": "1.7.14",
    "expo": "~58.0.21",
    "expo-constants": "~58.0.13",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.20",
    "expo-device": "~58.0.5",
    "expo-file-system": "~58.0.13",
    "expo-image-picker": "~58.0.10",
    "expo-linking": "~58.0.17",
    "expo-location": "~58.0.22",
    "expo-network": "~58.0.5",
    "expo-notifications": "~58.1.9",
    "expo-router": "~58.0.31",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.17",
    "expo-status-bar": "~58.0.5",
    "expo-web-browser": "~58.0.8",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.0",
    "react-native-web": "^0.21.4",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  },
  "overrides": {
    "@expo/fingerprint": {
      "minimatch": "11.0.8"
    }
  }
}
