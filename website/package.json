{
  "name": "offerme-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1 --port 3100",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3100",
    "typecheck": "tsc --noEmit",
    "contracts": "openapi-typescript http://127.0.0.1:4100/openapi.json -o src/api/generated/schema.d.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src tests playwright.config.ts next.config.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.3",
    "better-auth": "1.7.14",
    "lucide-react": "^0.468.0",
    "next": "16.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "openapi-typescript": "^7.10.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0"
  }
}
